# See https://github.com/seddonym/import-linter

[importlinter]
root_package = imgproxykit
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:layers]
name = Layered architecture of URL construction
type = layers

containers =
  imgproxykit

layers =
  # Optional framework adapters depend on the core, never the reverse:
  integrations
  # Coordinate path construction and signing:
  client
  # Independent client components:
  serialization | signing
  # Reusable processing configuration:
  transform
  options
  types
  # Shared low-level utilities:
  internal.encoding

[importlinter:contract:options-independence]
name = Concrete processing options must be independent
type = independence

modules =
  imgproxykit.options.*

ignore_imports =
  # Every concrete option implements the shared base contract:
  imgproxykit.options.* -> imgproxykit.options.base

[importlinter:contract:signing-independence]
name = Signing must not depend on processing or path construction
type = forbidden

source_modules =
  imgproxykit.signing

forbidden_modules =
  imgproxykit.serialization
  imgproxykit.transform
  imgproxykit.options
